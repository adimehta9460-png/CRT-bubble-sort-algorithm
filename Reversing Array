#include <iostream>
#include <vector>   // Needed for vector
#include <algorithm> // Optional, for swap
using namespace std;

class Solution {
public:
    void reverseArray(vector<int> &arr) {
        int n = arr.size();
        int i = 0, j = n - 1;
        while (i <= j) {
            swap(arr[i], arr[j]);
            i++;
            j--;  // Fixed missing semicolon
        }
    }
};

int main() {
    Solution sol;
    vector<int> arr = {1, 2, 3, 4, 5};

    sol.reverseArray(arr);

    cout << "Reversed array: ";
    for (int num : arr) {
        cout << num << " ";
    }
    cout << endl;

    return 0;
}
